---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { site } from '../data/site';
import { games } from '../lib/games';

const title = 'Barsuk Studio — Casual tap games';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  sameAs: [site.social.youtube, site.social.instagram, site.social.tiktok, site.social.discord].filter(Boolean),
};
---

<Base title={title} description={site.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Indie game studio</p>
        <h1>One tap.<br />A whole&nbsp;game.</h1>
        <p class="hero-lead">
          Barsuk Studio makes casual games in clean vector graphics — clickers, an
          action RPG, and puzzles you can pick up in a second and lose an hour to.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#games">Browse the games</a>
        </div>
        <div class="hero-stores">
          <StoreButtons googlePlay={site.stores.googlePlay} appStore={site.stores.appStore} label="Barsuk Studio" />
        </div>
      </div>

      <!-- Hero showcase image -->
      <div class="hero-shot">
        <img src="/img/savescreen.png" alt="Barsuk Studio game screenshot" width="1343" height="2469" fetchpriority="high" />
      </div>
    </div>
    <div class="stripe" aria-hidden="true"></div>
  </section>

  <section id="games" class="games">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">The arcade</p>
        <h2>{games.length} games to tap through</h2>
      </header>
      <div class="grid">
        {games.map((game, i) => <GameCard game={game} index={i} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 54px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    padding-bottom: 56px;
  }
  .hero-copy h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    margin: 14px 0 20px;
    font-weight: 800;
  }
  .hero-lead {
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 46ch;
  }
  .hero-actions {
    margin: 26px 0 22px;
  }

  /* Hero showcase image — tweak these to resize / reposition it */
  .hero-shot {
    display: flex;
    justify-content: center;   /* horizontal position: center | flex-start | flex-end */
    align-items: center;
  }
  .hero-shot img {
    width: 68%;                /* SIZE: how wide the phone image is in its column */
    max-width: 340px;          /* SIZE cap on large screens */
    height: auto;
    border-radius: 26px;       /* corner rounding */
    box-shadow: var(--shadow);
    transform: rotate(-3deg);  /* POSITION: tilt; use translate(x, y) to nudge */
  }

  /* Games section */
  .games {
    padding-top: 58px;
  }
  .section-head {
    margin-bottom: 30px;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 8px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 22px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-shot {
      order: -1;             /* show the image above the text on mobile */
    }
    .hero-shot img {
      width: 55%;
    }
  }
</style>
