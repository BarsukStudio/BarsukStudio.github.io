---
interface Props {
  googlePlay?: string;
  appStore?: string;
  /** Screen-reader context, e.g. the game name or "Barsuk Studio". */
  label?: string;
}
const { googlePlay, appStore, label = '' } = Astro.props;
const suffix = label ? ` — ${label}` : '';
---

<div class="store-row">
  {
    googlePlay && (
      <a class="store-badge" href={googlePlay} target="_blank" rel="noopener noreferrer" aria-label={`Google Play${suffix}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#f6b53f" d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L3.6 2.3Z" />
          <path fill="#f4ecde" d="m16.9 15.2-3.9-3.9v-.2l3.9-3.9.1.1 4.6 2.6c1.3.7 1.3 1.9 0 2.7l-4.6 2.6-.1-.1Z" />
          <path fill="#b7a996" d="m17 15.1-4-4-9.4 9.4c.4.5 1.2.5 2 .1l11.4-6.5" />
          <path fill="#897c6d" d="M17 8.9 5.6 2.4c-.8-.4-1.6-.4-2 .1l9.4 9.4 4-4Z" />
        </svg>
        <span>
          <span class="sb-top">Get it on</span>
          <span class="sb-main">Google Play</span>
        </span>
      </a>
    )
  }
  {
    appStore && (
      <a class="store-badge" href={appStore} target="_blank" rel="noopener noreferrer" aria-label={`App Store${suffix}`}>
        <svg viewBox="0 0 24 24" fill="#f4ecde" aria-hidden="true">
          <path d="M17.05 12.7c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.32.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.66-.39 6.6 1.09 8.76.72 1.06 1.58 2.25 2.71 2.2 1.09-.04 1.5-.7 2.82-.7 1.31 0 1.68.7 2.83.68 1.17-.02 1.91-1.07 2.62-2.14.83-1.23 1.17-2.42 1.19-2.48-.03-.01-2.28-.87-2.3-3.46ZM14.88 6.3c.6-.73 1-1.74.89-2.75-.86.03-1.9.57-2.52 1.3-.55.64-1.03 1.67-.9 2.65.96.07 1.94-.48 2.53-1.2Z" />
        </svg>
        <span>
          <span class="sb-top">Download on the</span>
          <span class="sb-main">App Store</span>
        </span>
      </a>
    )
  }
</div>
