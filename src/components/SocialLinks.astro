const labels: Record<string, string> = {
  youtube: 'YouTube',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  discord: 'Discord',
};

const links = Object.entries(site.social).filter(([, url]) => url);
---

{
  links.length > 0 && (
    <div class="socials">
      {links.map(([key, url]) => (
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={labels[key]}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[key]} />
        </a>
      ))}
    </div>
  )
}
